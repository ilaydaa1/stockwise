# Settings for `docker compose`. Copy this file to `.env` to change them.
# Every value is optional; the defaults below are what Compose uses
# when no .env file exists.

# Ports published on your computer.
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Database.
POSTGRES_USER=stockwise
POSTGRES_PASSWORD=stockwise_local_password
POSTGRES_DB=stockwise

# Change this for anything other than local development.
SECRET_KEY=dev-secret-change-in-production
