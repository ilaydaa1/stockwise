# StockWise Backend - Local Development Configuration
# Copy this file to .env and fill in your values.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=stockwise
POSTGRES_PASSWORD=stockwise_local_password
POSTGRES_DB=stockwise

# API
API_HOST=0.0.0.0
API_PORT=8000

# Connection pool
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_TIMEOUT=5

# Auth (generate a real secret for production)
SECRET_KEY=dev-secret-change-in-production
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_MAX_AGE=604800
CSRF_COOKIE_MAX_AGE=86400

# Rate limiting
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
